{
  "name": "starterkit-photobook-editor",
  "version": "1.0.0",
  "description": "CE.SDK Photobook Editor Starterkit",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "concurrently -k -n web,api \"VITE_USE_SERVER=true $npm_execpath run dev\" \"$npm_execpath run dev:api\"",
    "dev:api": "tsx src/server/index.ts",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check:syntax": "tsc --project tsconfig.json --noEmit && tsc --project src/server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cesdk/cesdk-js": "^1.83.0",
    "@cesdk/node-native": "^1.83.0",
    "@imgly/plugin-print-ready-pdfs-web": "^1.83.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "classnames": "^2.5.1",
    "@cesdk/engine": "^1.83.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "pdf-lib": "^1.17.1",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0",
    "vite": "^6.0.3"
  }
}
